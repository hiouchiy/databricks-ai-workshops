# Make a copy of this to set environment variables for local development
# cp .env.example .env

# TODO: Fill in auth related env vars
DATABRICKS_CONFIG_PROFILE=DEFAULT
# DATABRICKS_HOST=https://<your-workspace-here>.databricks.com
# DATABRICKS_TOKEN=dapi....

# TODO: Update with MLflow experiments
# MLFLOW_EXPERIMENT_ID — used for app tracing (monitoring) during runtime
# MLFLOW_EVAL_EXPERIMENT_ID — used for evaluation scripts (agent-evaluate, agent-evaluate-advanced, etc.)
MLFLOW_EXPERIMENT_ID=
MLFLOW_EVAL_EXPERIMENT_ID=
# トレース送信先（空 = MLflow Experiment（デフォルト）、設定あり = Unity Catalog Delta Table）
# 例: MLFLOW_TRACING_DESTINATION=my_catalog.my_schema
MLFLOW_TRACING_DESTINATION=

# TODO: Update with your Lakebase configuration (choose one option)
# Option 1 - Provisioned instance:
# LAKEBASE_INSTANCE_NAME=<your-lakebase-instance-name>
# Option 2 - Autoscaling (recommended):
# LAKEBASE_AUTOSCALING_PROJECT=<your-project-name>
# LAKEBASE_AUTOSCALING_BRANCH=<your-branch-name>

# TODO: Update with your Genie Space ID
GENIE_SPACE_ID=

# TODO: Update with your Vector Search index (format: catalog/schema/index-name)
VECTOR_SEARCH_INDEX=

# Lakebase connection (auto-filled by quickstart or set manually)
PGHOST=
PGUSER=
PGDATABASE=databricks_postgres

CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300
MLFLOW_TRACKING_URI="databricks"
MLFLOW_REGISTRY_URI="databricks-uc"

# LLM は Unity AI Gateway 経由でルーティングされる（デフォルト）。
# quickstart が下記 2 つを自動で設定するが、手動で書き換えることも可能。
# 参考: https://docs.databricks.com/aws/ja/ai-gateway/
LLM_USE_AI_GATEWAY=true
LLM_MODEL_SERVICE=system.ai.claude-sonnet-5
# Free Edition では system.ai.gpt-oss-120b が推奨（Claude 系は使用不可）
#
# 明示的に "false" を設定すると従来の direct 呼び出しにフォールバックする
# （その場合は LLM_ENDPOINT_NAME を指定：例 databricks-claude-sonnet-4-6）
# LLM_ENDPOINT_NAME=
